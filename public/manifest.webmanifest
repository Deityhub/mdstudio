{
  "name": "mdstudio",
  "short_name": "mdstudio",
  "description": "Free, open-source Markdown editor with live preview and portability checks for GitHub, dev.to and Obsidian.",
  "start_url": "/editor",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f9f5ec",
  "theme_color": "#b5532a",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
