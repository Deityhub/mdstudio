{
  // The real-time hub (see index.mjs). Deployed before the app, which binds to it by script name;
  // the workflows pass --name (mdstudio-realtime for production, mdstudio-realtime-preview shared by
  // previews). It is reached only through that binding, so it has no public address.
  "name": "mdstudio-realtime",
  "main": "index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "RealtimeHub" }] },
  // Workers Free only offers SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }]
}
